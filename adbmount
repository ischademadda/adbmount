#!/usr/bin/env bash
# adbmount: mount the phone's internal storage and SD card on macOS via adbfs.
#
#   adbmount up [--ro] [--only android|sdcard]   mount (default: both, read-write)
#   adbmount down                                unmount everything this tool mounted
#   adbmount status                              what is mounted, pids, mode
#   adbmount log android|sdcard                  tail the adbfs log
#
# Mount points: $ADBMOUNT_DIR/android (internal) and $ADBMOUNT_DIR/sdcard (default ~/mnt).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${ADBFS_BIN:-$HERE/adbfs}"
BASE="${ADBMOUNT_DIR:-$HOME/mnt}"
STATE="${HOME}/Library/Caches/adbfs/run"
mkdir -p "$STATE" "$BASE"

die() { echo "adbmount: $*" >&2; exit 1; }

mountpoint_of() { echo "$BASE/$1"; }
is_mounted()    { mount | grep -qF " on $(mountpoint_of "$1") ("; }
pid_of()        { cat "$STATE/$1.pid" 2>/dev/null || true; }
is_ours()       { local p="$1"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -p "$p" -o command= | grep -q "adbfs"; }

need_device() {
  command -v adb >/dev/null || die "adb not found in PATH (brew install android-platform-tools)"
  [ "$(adb get-state 2>/dev/null || true)" = "device" ] || die "no phone visible (adb get-state != device): check the cable, USB debugging and the authorization prompt on the phone"
}

sd_root() {
  adb shell 'ls /storage' 2>/dev/null | tr -d '\r' | grep -E '^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$' | head -1 || true
}

start() { # name remote-root volume-name [extra adbfs flags...]
  local name="$1" root="$2" vol="$3"; shift 3
  local mnt; mnt="$(mountpoint_of "$name")"
  if is_mounted "$name"; then echo "  $name: already mounted ($mnt)"; return; fi
  [ -x "$BIN" ] || (cd "$HERE" && go build -o adbfs .) || die "no binary at $BIN and the build failed (run make build)"
  nohup "$BIN" -root "$root" -mount "$mnt" -volname "$vol" "$@" >"$STATE/$name.log" 2>&1 &
  echo $! >"$STATE/$name.pid"
  for _ in $(seq 1 40); do
    if is_mounted "$name"; then echo "  $name: $root → $mnt"; return; fi
    is_ours "$(pid_of "$name")" || { tail -5 "$STATE/$name.log" >&2; die "$name: adbfs exited during startup"; }
    sleep 0.5
  done
  die "$name: not mounted after 20 s (log: $STATE/$name.log)"
}

stop() { # name
  local name="$1" mnt pid; mnt="$(mountpoint_of "$name")"; pid="$(pid_of "$name")"
  if is_mounted "$name"; then diskutil unmount force "$mnt" >/dev/null 2>&1 || umount -f "$mnt" 2>/dev/null || true; fi
  if is_ours "$pid"; then
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$STATE/$name.pid"
  if is_mounted "$name"; then echo "  $name: could NOT unmount (busy?)"; else echo "  $name: unmounted"; fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
  up)
    RO=(); ONLY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --ro) RO=(-ro) ;;
        --only) ONLY="${2:-}"; shift ;;
        *) die "unknown flag: $1" ;;
      esac; shift
    done
    need_device
    echo "Mounting${RO:+ (read-only)}:"
    if [ -z "$ONLY" ] || [ "$ONLY" = android ]; then start android /sdcard Android ${RO[@]+"${RO[@]}"}; fi
    if [ -z "$ONLY" ] || [ "$ONLY" = sdcard ]; then
      SD="$(sd_root)"
      if [ -n "$SD" ]; then start sdcard "/storage/$SD" SDCard ${RO[@]+"${RO[@]}"}
      else echo "  sdcard: no SD card found, skipping"; fi
    fi ;;
  down)
    echo "Unmounting:"; stop sdcard; stop android ;;
  status)
    for n in android sdcard; do
      pid="$(pid_of "$n")"
      if is_mounted "$n"; then printf "%-8s mounted      %s  pid=%s\n" "$n" "$(mountpoint_of "$n")" "${pid:-?}"
      else printf "%-8s not mounted\n" "$n"; fi
    done ;;
  log)
    [ -n "${1:-}" ] || die "usage: adbmount log android|sdcard"
    tail -n 50 "$STATE/$1.log" ;;
  *)
    sed -n '2,10p' "$0"; exit 1 ;;
esac
